<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confronter Tech Wizard Gains</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #000000;
      --card: #0a0a0a;
      --text: #ffffff;
      --text-secondary: #888888;
      --border: #222222;
      --input-bg: #111111;
      --accent: #ffffff;
      --error: #ff4444;
      --success: #00ff88;
      --warning: #ffaa00;
      --whatsapp: #25d366;
      --whatsapp-dim: #1a5c2e;
    }

    [data-theme="light"] {
      --bg: #ffffff;
      --card: #f5f5f5;
      --text: #000000;
      --text-secondary: #666666;
      --border: #dddddd;
      --input-bg: #ffffff;
      --accent: #000000;
      --error: #cc0000;
      --success: #00aa44;
      --warning: #cc8800;
      --whatsapp: #128c7e;
      --whatsapp-dim: #a0c4b8;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      transition: background 0.3s, color 0.3s;
    }

    .theme-toggle {
      position: fixed;
      top: 20px;
      right: 20px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      transition: all 0.3s;
      z-index: 100;
    }
    .theme-toggle:hover { transform: scale(1.1); border-color: var(--accent); }

    .status-bar {
      position: fixed;
      top: 20px;
      left: 20px;
      display: flex;
      align-items: center;
      gap: 14px;
      z-index: 100;
      font-family: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
    }

    .status-item {
      display: flex;
      align-items: center;
      gap: 6px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 8px 14px;
      font-size: 0.8rem;
      color: var(--text-secondary);
      transition: all 0.3s;
    }

    .status-item .icon {
      font-size: 1rem;
      line-height: 1;
    }

    .status-item .value {
      font-family: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--text);
      letter-spacing: 0.3px;
    }

    .status-item .label {
      font-size: 0.7rem;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .container {
      width: 100%;
      max-width: 440px;
      animation: fadeIn 0.5s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 36px 28px;
    }

    .logo {
      text-align: center;
      margin-bottom: 24px;
    }

    .logo img {
      width: 120px;
      height: 120px;
      border-radius: 50%;
      object-fit: cover;
      margin-bottom: 16px;
      border: 2px solid var(--border);
    }

    h1 {
      font-size: 1.3rem;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .subtitle {
      color: var(--text-secondary);
      font-size: 0.85rem;
    }

    /* WhatsApp button — DIM before form fill, ACTIVE after verification */
    .whatsapp-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 12px;
      padding: 10px 20px;
      background: var(--whatsapp-dim);
      color: rgba(255,255,255,0.4);
      text-decoration: none;
      border-radius: 24px;
      font-size: 0.85rem;
      font-weight: 600;
      transition: all 0.3s ease;
      pointer-events: none;
      cursor: not-allowed;
      border: 1px solid transparent;
    }
    .whatsapp-link.active {
      background: var(--whatsapp);
      color: #fff;
      pointer-events: auto;
      cursor: pointer;
      border-color: var(--whatsapp);
      box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
    }
    .whatsapp-link.active:hover {
      opacity: 0.85;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
    }
    .whatsapp-link i { font-size: 1rem; }
    .whatsapp-link .lock-icon {
      font-size: 0.75rem;
      margin-left: 4px;
    }
    .whatsapp-link.active .lock-icon {
      display: none;
    }

    .progress-wrap {
      margin: 20px 0;
    }

    .progress-bar {
      width: 100%;
      height: 4px;
      background: var(--border);
      border-radius: 2px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: var(--text);
      border-radius: 2px;
      transition: width 0.5s ease;
      width: 0%;
    }

    .count {
      text-align: center;
      font-size: 0.75rem;
      color: var(--text-secondary);
      margin-top: 8px;
    }

    .count span {
      color: var(--text);
      font-weight: 600;
    }

    .alert {
      padding: 14px 16px;
      border-radius: 10px;
      margin-bottom: 16px;
      font-size: 0.85rem;
      display: none;
      align-items: center;
      gap: 10px;
    }

    .alert.show { display: flex; }
    .alert-error { background: rgba(255,68,68,0.08); border: 1px solid rgba(255,68,68,0.2); color: var(--error); }
    .alert-warn { background: rgba(255,170,0,0.08); border: 1px solid rgba(255,170,0,0.2); color: var(--warning); }

    .form-group {
      margin-bottom: 16px;
    }

    label {
      display: block;
      font-size: 0.8rem;
      font-weight: 500;
      margin-bottom: 6px;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    input, select {
      width: 100%;
      padding: 12px 14px;
      background: var(--input-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      font-size: 0.95rem;
      font-family: inherit;
      transition: all 0.2s;
      outline: none;
    }

    input::placeholder { color: var(--text-secondary); opacity: 0.5; }

    input:focus, select:focus {
      border-color: var(--accent);
    }

    input.error {
      border-color: var(--error);
      animation: shake 0.3s ease;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-6px); }
      75% { transform: translateX(6px); }
    }

    .phone-row {
      display: flex;
      gap: 8px;
    }

    .phone-row select {
      width: 100px;
      flex-shrink: 0;
      padding: 12px 8px;
      font-size: 0.85rem;
    }

    .phone-row input { flex: 1; }

    .error-msg {
      color: var(--error);
      font-size: 0.75rem;
      margin-top: 5px;
      display: none;
    }

    .error-msg.show { display: block; }

    .btn {
      width: 100%;
      padding: 14px;
      background: var(--text);
      color: var(--bg);
      border: none;
      border-radius: 10px;
      font-size: 0.95rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s;
      margin-top: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn:hover {
      opacity: 0.85;
      transform: translateY(-1px);
    }

    .btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      transform: none;
    }

    .btn .spinner {
      display: none;
      width: 18px;
      height: 18px;
      border: 2px solid rgba(0,0,0,0.2);
      border-top-color: var(--bg);
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }

    [data-theme="light"] .btn .spinner {
      border-color: rgba(255,255,255,0.3);
      border-top-color: var(--text);
    }

    .btn.loading .btn-text { display: none; }
    .btn.loading .spinner { display: block; }

    @keyframes spin { to { transform: rotate(360deg); } }

    /* VCF Download Card */
    .vcf-download-card {
      background: linear-gradient(135deg, rgba(0,255,136,0.05), rgba(0,255,136,0.02));
      border: 1px solid rgba(0,255,136,0.2);
      border-radius: 12px;
      padding: 16px 20px;
      margin: 16px 0;
      display: none;
      align-items: center;
      gap: 14px;
      transition: all 0.3s;
    }
    .vcf-download-card.show { display: flex; }
    .vcf-download-card:hover {
      border-color: rgba(0,255,136,0.4);
      background: linear-gradient(135deg, rgba(0,255,136,0.08), rgba(0,255,136,0.03));
    }
    .vcf-icon {
      width: 44px;
      height: 44px;
      background: rgba(0,255,136,0.1);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: var(--success);
      flex-shrink: 0;
    }
    .vcf-info { flex: 1; }
    .vcf-info .vcf-title {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 2px;
    }
    .vcf-info .vcf-meta {
      font-size: 0.75rem;
      color: var(--text-secondary);
    }
    .vcf-info .vcf-expiry {
      font-size: 0.7rem;
      color: var(--warning);
      margin-top: 4px;
    }
    .vcf-download-btn {
      padding: 8px 16px;
      background: var(--success);
      color: #000;
      border: none;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
      flex-shrink: 0;
    }
    .vcf-download-btn:hover {
      opacity: 0.85;
      transform: scale(1.05);
    }

    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.8);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      backdrop-filter: blur(8px);
    }

    .overlay.show { display: flex; }

    .overlay-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 44px 36px;
      text-align: center;
      max-width: 380px;
      width: 90%;
      animation: scaleIn 0.3s ease;
    }

    @keyframes scaleIn {
      from { transform: scale(0.9); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .overlay-icon {
      width: 64px;
      height: 64px;
      background: var(--success);
      color: #000;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      margin-bottom: 18px;
    }

    .overlay-card h2 {
      font-size: 1.3rem;
      margin-bottom: 8px;
    }

    .overlay-card p {
      color: var(--text-secondary);
      font-size: 0.9rem;
      margin-bottom: 6px;
    }

    .timer {
      font-size: 2.5rem;
      font-weight: 800;
      margin: 14px 0;
    }

    .footer {
      text-align: center;
      margin-top: 20px;
    }

    .footer a {
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.75rem;
      transition: color 0.2s;
    }

    .footer a:hover { color: var(--text); }

    @media (max-width: 480px) {
      .card { padding: 24px 20px; }
      h1 { font-size: 1.15rem; }
      .status-bar { flex-wrap: wrap; gap: 8px; }
      .logo img { width: 90px; height: 90px; }
      .vcf-download-card { flex-direction: column; text-align: center; }
    }
  </style>
</head>
