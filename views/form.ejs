  <script>
    // Theme toggle
    const themeToggle = document.getElementById('themeToggle');
    const themeIcon = document.getElementById('themeIcon');
    const savedTheme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
    themeIcon.className = savedTheme === 'dark' ? 'fas fa-sun' : 'fas fa-moon';

    themeToggle.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      themeIcon.className = next === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
    });

    // Real-time clock
    function updateClock() {
      const now = new Date();
      const time = now.toLocaleTimeString('en-US', { hour12: false });
      const day = now.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
      document.getElementById('liveClock').textContent = time;
      document.getElementById('liveDay').textContent = day;
    }
    updateClock();
    setInterval(updateClock, 1000);

    // Battery status
    async function updateBattery() {
      try {
        if ('getBattery' in navigator) {
          const battery = await navigator.getBattery();
          const percent = Math.round(battery.level * 100);
          const charging = battery.charging;
          document.getElementById('batteryPercent').textContent = percent + '%' + (charging ? ' ⚡' : '');
          battery.addEventListener('levelchange', updateBattery);
          battery.addEventListener('chargingchange', updateBattery);
        } else {
          document.getElementById('batteryPercent').textContent = 'N/A';
        }
      } catch (e) {
        document.getElementById('batteryPercent').textContent = 'N/A';
      }
    }
    updateBattery();

    // Speech synthesis
    function speakSuccess() {
      try {
        if ('speechSynthesis' in window) {
          const utterance = new SpeechSynthesisUtterance('You were verified successfully. Welcome to Confronter Tech Wizard Gains.');
          utterance.rate = 0.9;
          utterance.pitch = 1;
          utterance.volume = 1;
          speechSynthesis.speak(utterance);
        }
      } catch (e) { console.log('Speech not supported'); }
    }

    // Form logic
    const form = document.getElementById('contactForm');
    const submitBtn = document.getElementById('submitBtn');
    const successOverlay = document.getElementById('successOverlay');
    const duplicateWarning = document.getElementById('duplicateWarning');
    const fullMessage = document.getElementById('fullMessage');
    const whatsappBtn = document.getElementById('whatsappBtn');
    const vcfCard = document.getElementById('vcfCard');
    const vcfFilename = document.getElementById('vcfFilename');
    const vcfMeta = document.getElementById('vcfMeta');
    const vcfExpiry = document.getElementById('vcfExpiry');
    const vcfDownloadBtn = document.getElementById('vcfDownloadBtn');

    let groupLink = 'https://chat.whatsapp.com/G9qtX0Yuq61JjrklH8k803?s=cl&p=a&ilr=1';
    let memberLimit = 700;

    async function loadSettings() {
      try {
        const res = await fetch('/api/settings');
        const data = await res.json();
        if (data.success) {
          memberLimit = data.memberLimit || 700;
          if (data.groupLink) {
            groupLink = data.groupLink;
            whatsappBtn.href = groupLink;
          }
        }
      } catch (e) {}
    }
    loadSettings();

    async function loadCount() {
      try {
        const res = await fetch('/api/members/count');
        const data = await res.json();
        if (data.success) {
          document.getElementById('progressFill').style.width = (data.count / memberLimit * 100) + '%';
          document.getElementById('memberCount').innerHTML = '<span>' + data.count + '</span> / ' + memberLimit + ' members (' + (memberLimit - data.count) + ' left)';
          if (data.count >= memberLimit) {
            fullMessage.classList.add('show');
            form.style.display = 'none';
          }
        }
      } catch (e) {
        document.getElementById('memberCount').textContent = 'Unable to load';
      }
    }
    loadCount();

    // Load VCF status from admin
    async function loadVCF() {
      try {
        const res = await fetch('/api/vcf-status');
        const data = await res.json();
        if (data.success && data.hasUpload && data.visible) {
          vcfCard.classList.add('show');
          vcfFilename.textContent = data.filename || 'Contact Card';
          vcfMeta.textContent = 'VCF file • ' + (data.fileSize || 'Unknown size');
          if (data.expiryDate) {
            const daysLeft = Math.ceil((new Date(data.expiryDate) - new Date()) / (1000 * 60 * 60 * 24));
            vcfExpiry.textContent = daysLeft > 0 ? '⏳ Expires in ' + daysLeft + ' days' : '⚠️ Expired';
            if (daysLeft <= 0) {
              vcfDownloadBtn.style.opacity = '0.4';
              vcfDownloadBtn.style.pointerEvents = 'none';
              vcfDownloadBtn.innerHTML = '<i class="fas fa-lock"></i> Expired';
            }
          } else {
            vcfExpiry.textContent = '';
          }
        } else {
          vcfCard.classList.remove('show');
        }
      } catch (e) {
        vcfCard.classList.remove('show');
      }
    }
    loadVCF();

    // Real-time duplicate check
    let checkTimeout;
    const phoneInput = document.getElementById('phone');
    const emailInput = document.getElementById('email');

    async function checkDup() {
      const phone = phoneInput.value.trim();
      const email = emailInput.value.trim();
      const cc = document.getElementById('countryCode').value;
      if (!phone && !email) return;
      try {
        const params = new URLSearchParams();
        if (phone) params.append('phone', cc + phone);
        if (email) params.append('email', email);
        const res = await fetch('/api/members/check?' + params);
        const data = await res.json();
        if (data.exists) {
          duplicateWarning.classList.add('show');
          document.getElementById('duplicateText').textContent = 'This ' + data.field + ' is already registered.';
          submitBtn.disabled = true;
        } else {
          duplicateWarning.classList.remove('show');
          submitBtn.disabled = false;
        }
      } catch (e) {}
    }

    phoneInput.addEventListener('input', () => { clearTimeout(checkTimeout); checkTimeout = setTimeout(checkDup, 500); });
    emailInput.addEventListener('input', () => { clearTimeout(checkTimeout); checkTimeout = setTimeout(checkDup, 500); });

    // Submit
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      document.querySelectorAll('.error-msg').forEach(el => el.classList.remove('show'));
      document.querySelectorAll('input').forEach(el => el.classList.remove('error'));

      const fullName = document.getElementById('fullName').value.trim();
      const phone = document.getElementById('phone').value.trim();
      const email = document.getElementById('email').value.trim();
      const countryCode = document.getElementById('countryCode').value;

      let err = false;
      if (fullName.length < 2) { document.getElementById('nameError').classList.add('show'); document.getElementById('fullName').classList.add('error'); err = true; }
      if (!phone) { document.getElementById('phoneError').classList.add('show'); document.getElementById('phone').classList.add('error'); err = true; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { document.getElementById('emailError').classList.add('show'); document.getElementById('email').classList.add('error'); err = true; }
      if (err) return;

      submitBtn.classList.add('loading');
      submitBtn.disabled = true;

      try {
        const res = await fetch('/api/members', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fullName, phone, email, countryCode })
        });
        const data = await res.json();

        if (data.success) {
          // Speak success message
          speakSuccess();

          // Activate WhatsApp button
          whatsappBtn.classList.add('active');
          whatsappBtn.innerHTML = '<i class="fab fa-whatsapp"></i> Join WhatsApp Group';

          successOverlay.classList.add('show');
          let sec = 3;
          const timer = setInterval(() => {
            sec--;
            document.getElementById('redirectTimer').textContent = sec;
            if (sec <= 0) {
              clearInterval(timer);
              // Redirect to WhatsApp group after speech
              window.location.href = groupLink;
            }
          }, 1000);
        } else if (data.duplicate) {
          duplicateWarning.classList.add('show');
          document.getElementById('duplicateText').textContent = data.message;
        } else {
          duplicateWarning.classList.add('show');
          document.getElementById('duplicateText').textContent = data.message || 'Something went wrong. Please try again.';
        }
      } catch (error) {
        console.error('Submit error:', error);
        duplicateWarning.classList.add('show');
        document.getElementById('duplicateText').textContent = 'Connection failed. Check your internet or try again.';
      } finally {
        submitBtn.classList.remove('loading');
        submitBtn.disabled = false;
      }
    });

    // Auto-detect country
    const region = (navigator.language || 'en-US').split('-')[1];
    const map = { US:'+1', GB:'+44', NG:'+234', ZA:'+27', KE:'+254', GH:'+233', TZ:'+255', UG:'+256', IN:'+91', PK:'+92', CN:'+86', JP:'+81', DE:'+49', FR:'+33', IT:'+39', ES:'+34', RU:'+7', BR:'+55', MX:'+52', AU:'+61', NZ:'+64', SG:'+65', AE:'+971', SA:'+966', EG:'+20', MA:'+212', ET:'+251', RW:'+250' };
    if (map[region]) document.getElementById('countryCode').value = map[region];
  </script>
</body>
</html>
